# Paste the PROJECT API key here. Do not commit this file.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Created when you configure the OpenAI Project webhook endpoint.
OPENAI_WEBHOOK_SECRET=whsec_REPLACE_ME

# Protects the local/admin knowledge-base endpoints.
ADMIN_TOKEN=replace-with-a-long-random-string

RESTAURANT_NAME=Example Restaurant

# GPT-Live frontend (voice conversation)
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin

# Delegated reasoning / tool-selection backend.
# OpenAI's GPT-Live docs recommend starting with gpt-6-luna for low-latency backend work.
BACKEND_MODEL=gpt-6-luna

# RAG embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Local KB storage
DB_PATH=./data/knowledge.sqlite3
AUTO_BOOTSTRAP_KB=true
BUNDLED_KB_PATH=./data/McDonalds_About_Our_Food_Summary.txt
BUNDLED_KB_SOURCE=mcdonalds-about-our-food-2026-10-06

# Operational settings
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false
GREET_ON_CONNECT=true
